# ==========================================
# AI Response Validation System Environment
# ==========================================

# Active LLM Provider: 'groq' | 'ollama' | 'openai'
LLM_PROVIDER=groq

# Optional Failover Provider (attempted if primary provider exhausts all retries)
LLM_FALLBACK_PROVIDER=

# Groq Cloud Settings (Default Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama Settings (Local / Offline Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI Settings (or OpenAI-Compatible Endpoints: vLLM, Together, LocalAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Settings
PORT=8000

# Optional API Security (Leave blank for open local dev; set to require X-API-KEY header)
ARVS_API_KEY=

